                    "endpoint": "https://maps.dwd.de/geoserver/dwd/wms",
                    "visible": true,
                    "opacity": 0.6,
                    "attribution": "© Deutscher Wetterdienst",
                    "wms": {
                        "layers": ["Icon_reg025_fd_sl_T2M"],
                        "featureInfo": {
                            "format": "application/json",
                            "fields": [
                                {
                                    "property": "Temperature_height_level_above_ground",
                                    "label": {
                                        "de": "Lufttemperatur 2 m",
                                        "en": "Air temperature 2 m"
                                    },
                                    "unit": "°C"
                                },
                                {
                                    "property": "TIME",
                                    "label": {
                                        "de": "Gültig für",
                                        "en": "Valid for"
                                    }
                                },
                                {
                                    "property": "REFERENCE_TIME",
                                    "label": {
                                        "de": "Modelllauf",
                                        "en": "Model run"
                                    }
                                }
                            ]
                        },
                        "legend": {
                            "params": {
                                "WIDTH": "12",
                                "HEIGHT": "12",
                                "LEGEND_OPTIONS": "columns:4;fontSize:9"
                            }
                        }
                    }
                },
                {
                    "id": "dwd-radolan-rw",
                    "type": "wms",
                    "name": {
                        "de": "Niederschlag letzte Stunde (DWD Radar)",
                        "en": "Precipitation last hour (DWD radar)"
                    },
                    "description": {
                        "de": "An Stationsdaten angeeichtes Radarkomposit des Deutschen Wetterdienstes (RADOLAN RW): Niederschlagssumme der letzten Stunde, nur Deutschland.",
                        "en": "Radar composite of the German Weather Service (DWD), calibrated with station data (RADOLAN RW): precipitation of the last hour, Germany only."
                    },
                    "endpoint": "https://maps.dwd.de/geoserver/dwd/wms",
                    "visible": true,
                    "opacity": 0.7,
                    "attribution": "© Deutscher Wetterdienst",
                    "wms": {
                        "layers": ["RADOLAN-RW"],
                        "featureInfo": {
                            "format": "application/json",
                            "fields": [
                                {
                                    "property": "RW_HDF5",
                                    "label": {
                                        "de": "Niederschlag (1 h)",
                                        "en": "Precipitation (1 h)"
                                    },
                                    "unit": "mm"
                                },
                                {
                                    "property": "TIME",
                                    "label": {
                                        "de": "Messzeit",
                                        "en": "Observed at"
                                    }
                                }
                            ]
                        },
                        "legend": {
                            "params": {
                                "WIDTH": "12",
                                "HEIGHT": "12",
                                "LEGEND_OPTIONS": "columns:4;fontSize:9"
                            }
                        }
                    }
                }
            ]
        },
        {

            "layers": [
                {
                    "id": "dwd-icon-t2m",
                    "type": "wms",
                    "name": {
                        "de": "Lufttemperatur 2 m (DWD ICON)",
                        "en": "Air temperature 2 m (DWD ICON)"
                    },
                    "description": {
                        "de": "Vorhersage der Lufttemperatur in 2 m Höhe aus dem ICON-Modell des Deutschen Wetterdienstes.",
                        "en": "Forecast of the air temperature at 2 m height from the ICON model of the German Weather Service (DWD)."
